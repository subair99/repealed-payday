# Copy to .env and fill in. Never commit or zip the real .env.
# Provider key (any OpenAI-compatible endpoint). OPENROUTER_API_KEY / NEBIUS_API_KEY also accepted.
API_KEY=
# Leave empty for OpenRouter. OpenAI direct: https://api.openai.com/v1  Nebius: https://api.tokenfactory.nebius.com/v1/
OPENAI_BASE_URL=
# Space-separated model IDs in double quotes, e.g. MODELS="openai/x anthropic/y"
MODELS=""
# 0 by default; set to none for reasoning models that only accept their default
TEMPERATURE=
# Max output tokens per model call (also limits how much credit OpenRouter reserves per request)
MAX_OUTPUT_TOKENS=16000
